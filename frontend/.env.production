# Umami Cloud analytics — loaded by `vite build` (production) only, so dev
# servers, vitest and the e2e build never track. The website id is NOT a
# secret: it ships in the page HTML by design (like the snippet Umami hands
# out), so it is safe to commit. Keep `data-domains` (VITE_UMAMI_DOMAINS)
# pointed at the prod host so a dist served from anywhere else stays clean.
VITE_UMAMI_SRC=https://cloud.umami.is/script.js
VITE_UMAMI_WEBSITE_ID=8569fc81-5216-4f61-bc1c-19bc14dc75eb
VITE_UMAMI_DOMAINS=meteo.codeas.me
